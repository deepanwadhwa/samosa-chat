#!/bin/sh
# samosa — chat with Qwen3.6-35B-A3B locally. No cloud, no account, no telemetry.
#
#   samosa "explain how DNS works"          answer a question
#   samosa --continue "and DNSSEC?"         follow up on the last conversation
#   samosa --think "hard logic puzzle"      general reasoning profile
#   samosa --think-code "build a page"      precise coding/WebDev profile
#   samosa --fast "..."                     adaptive thermal thread scaling (faster, runs warmer)
#   samosa --seed N "..."                   reproducible sampling
#   samosa --max-tokens N "..."             override the safety ceiling
#   samosa --context-tokens N "..."         set total context capacity (or auto)
#   samosa --thinking-budget N "..."         cap internal reasoning before the answer
#   samosa serve                            start the local app server in background
#   samosa serve --lan                      share it with this local network
#   samosa serve --foreground               run attached for debugging
#   samosa serve --stop                     stop the local app server cleanly
#   samosa app                              start the server and open the browser app
#   samosa app --lan                        open locally and print a private LAN link
#   samosa jobs <command> <job.json>         run structured local batch work
#   samosa pull                             pull the 24 GB model to local volume
#   samosa doctor                           check the installation
#   samosa version                          print the installed version
#
# Conversations resume instantly from a small snapshot — your chat history
# never has to be re-processed, even after a reboot.

set -eu

HOME_DIR="${SAMOSA_HOME:-$HOME/.samosa}"
SELF_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
if [ -n "${SAMOSA_RELEASE_DIR:-}" ]; then
  RELEASE_DIR=$SAMOSA_RELEASE_DIR
elif [ -x "$SELF_DIR/qwen36b" ] && [ -x "$SELF_DIR/samosa-gateway" ]; then
  # A model directory is no longer a reliable signal here: a runtime-only
  # release (docs/TASKS_UI_CHUTNI.md T1.0) has none by design. Detect a real
  # release/bin directory by its two mandatory runtime binaries instead.
  RELEASE_DIR=$(CDPATH= cd -- "$SELF_DIR/.." && pwd)
else
  RELEASE_DIR=$HOME_DIR
fi
ENGINE="$RELEASE_DIR/bin/qwen36b"
GATEWAY="$RELEASE_DIR/bin/samosa-gateway"
MODEL="$HOME_DIR/models/qwen"
TOKENIZER="$HOME_DIR/models/qwen/tokenizer_qwen36.json"
APP_HTML="$RELEASE_DIR/app.html"
APP_LOGO="$RELEASE_DIR/samosa-chat.png"
MODELS_CATALOG="$RELEASE_DIR/models.json"
SESSION="$HOME_DIR/last_session.qws"

# Version. Packaging replaces the empty assignment below with the real number
# (tools/package_hf.py). In a source checkout it stays empty, so fall back to
# the VERSION file at the release/repo root. The marker string appears here
# once, only in the assignment, so a whole-string substitution cannot corrupt
# the fallback logic.
SAMOSA_VERSION=""
if [ -z "$SAMOSA_VERSION" ]; then
  for _vf in "$RELEASE_DIR/VERSION" "$SELF_DIR/../VERSION"; do
    if [ -f "$_vf" ]; then
      SAMOSA_VERSION=$(sed -n '1p' "$_vf" | tr -d '[:space:]')
      break
    fi
  done
fi
[ -n "$SAMOSA_VERSION" ] || SAMOSA_VERSION="unknown"
PORT="${SAMOSA_PORT:-8642}"
BACKEND_PORT="${SAMOSA_BACKEND_PORT:-$((PORT + 1))}"
BIND_ADDRESS="${SAMOSA_BIND:-${SAMOSA_HOST:-127.0.0.1}}"
LAN_MODE="${SAMOSA_LAN:-0}"
if [ "${SAMOSA_LAN_PASSWORD+x}" = x ]; then
  LAN_PASSWORD_EXPLICIT=1
else
  LAN_PASSWORD_EXPLICIT=0
fi
LAN_PASSWORD="${SAMOSA_LAN_PASSWORD:-password1234}"
PID_FILE="$HOME_DIR/server.pid"
BACKEND_PID_FILE="$HOME_DIR/run/backend.pid"
SERVER_LOG="$HOME_DIR/server.log"
RUN_DIR="$HOME_DIR/run"
UI_TOKEN_FILE="$RUN_DIR/ui-token"
LAUNCHD_PLIST="$RUN_DIR/com.samosa.app.$PORT.plist"
if [ "$PORT" = 8642 ]; then
  LAUNCH_LABEL="com.samosa.app"
else
  LAUNCH_LABEL="com.samosa.app.$PORT"
fi
LAUNCH_DOMAIN="gui/$(id -u)"
CURL="${SAMOSA_CURL:-curl}"
LAUNCHCTL="${SAMOSA_LAUNCHCTL:-launchctl}"
if [ "$(uname -s)" = "Darwin" ]; then
  OPEN="${SAMOSA_OPEN:-open}"
else
  OPEN="${SAMOSA_OPEN:-xdg-open}"
fi

PROFILE="direct"
TOKENS=""
THINKING_BUDGET=""
RESUME=""
SEED=""
CONTEXT_TOKENS="${SAMOSA_CONTEXT_TOKENS:-auto}"
VOICE_TRACE_AUTO="${SAMOSA_VOICE_TRACE_AUTO:-0}"
APP_LIFECYCLE=0

say()  { printf '\033[1;36m[samosa]\033[0m %s\n' "$*"; }
fail() { printf '\033[1;31m[samosa] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    fail "neither sha256sum nor shasum is available"
  fi
}

pull_model() {
  BASE_URL="${SAMOSA_BASE_URL:-https://huggingface.co/REPO_ID_PLACEHOLDER/resolve/main}"
  MODEL_DIR="/model"
  mkdir -p "$MODEL_DIR"
  MANIFEST="$MODEL_DIR/release-manifest.tsv"
  
  say "Fetching release manifest..."
  "$CURL" -fL --retry 5 --retry-delay 3 --progress-bar \
    "$BASE_URL/release-manifest.tsv" -o "$MANIFEST.next" \
    || fail "release manifest download failed"
    
  awk -F '\t' '
    NF != 3 || length($1) != 64 || $1 !~ /^[0-9a-f]+$/ || $2 !~ /^[0-9]+$/ ||
    $3 == "" || $3 ~ /^\// || $3 ~ /(^|\/)\.\.(\/|$)/ { exit 1 }
  ' "$MANIFEST.next" || fail "release manifest is malformed or unsafe"
  
  mv -f "$MANIFEST.next" "$MANIFEST"
  
  # We only pull the model files and the tokenizer to the volume
  PULL_FILES="experts.bin resident.safetensors manifest.json config.json generation_config.json tokenizer_qwen36.json"
  
  manifest_field() {
    awk -F '\t' -v p="$1" -v c="$2" '$3==p {print $c; found=1} END {if(!found) exit 1}' "$MANIFEST"
  }
  
  verified() {
    want=$(manifest_field "$1" 1) || return 1
    size=$(manifest_field "$1" 2) || return 1
    [ -f "$2" ] || return 1
    [ "$(wc -c <"$2" | tr -d ' ')" = "$size" ] || return 1
    have=$(sha256_file "$2")
    [ "$want" = "$have" ]
  }
  
  fetch() {
    relative=$1; target=$2
    say "downloading $relative ..."
    "$CURL" -fL --retry 5 --retry-delay 3 -C - --progress-bar \
      "$BASE_URL/$relative" -o "$target" \
      || fail "download failed for $relative - re-run to resume"
  }
  
  for relative in $PULL_FILES; do
    target="$MODEL_DIR/$relative"
    if verified "$relative" "$target"; then
      say "$relative already verified - skipping"
    else
      fetch "$relative" "$target"
      verified "$relative" "$target" ||
        fail "checksum mismatch for $relative"
    fi
  done
  
  say "Model pull complete."
}

usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }
print_version() {
  echo "samosa $SAMOSA_VERSION"
  [ "$RELEASE_DIR" = "$HOME_DIR" ] || echo "release: $(basename "$RELEASE_DIR")"
}

positive_integer() {
  case "$1" in ''|*[!0-9]*|0) return 1 ;; *) return 0 ;; esac
}

context_tokens_value() {
  [ "$1" = "auto" ] || positive_integer "$1"
}

server_running() {
  "$CURL" -fsS --max-time 1 "http://127.0.0.1:$PORT/healthz" >/dev/null 2>&1
}

server_listen_address() {
  "$CURL" -fsS --max-time 1 "http://127.0.0.1:$PORT/healthz" 2>/dev/null |
    sed -n 's/.*"listen_address":"\([^"]*\)".*/\1/p'
}

server_lan_auth() {
  "$CURL" -fsS --max-time 1 "http://127.0.0.1:$PORT/healthz" 2>/dev/null |
    sed -n 's/.*"lan_auth":"\([^"]*\)".*/\1/p'
}

server_bind_matches() {
  actual=$(server_listen_address || true)
  # An older loopback gateway does not report this field. Preserve ordinary
  # local compatibility, but restart it when the user explicitly requests LAN
  # mode; otherwise `app --lan` would print a link to a loopback-only process.
  [ -z "$actual" ] && [ "$BIND_ADDRESS" = "127.0.0.1" ] && [ "$LAN_MODE" = 0 ] && return 0
  [ "$actual" = "$BIND_ADDRESS" ] || return 1
  if [ "$LAN_MODE" = 1 ]; then
    [ "$(server_lan_auth || true)" = password ] || return 1
    # Health checks intentionally do not reveal the password (or a reusable
    # derivative). When a password was supplied explicitly, restart so the
    # running service always receives that requested value.
    [ "$LAN_PASSWORD_EXPLICIT" = 0 ]
  else
    [ "$(server_lan_auth || true)" != password ]
  fi
}

restart_for_bind_change() {
  server_running || return 0
  server_bind_matches && return 0
  say "restarting the server to listen on $BIND_ADDRESS"
  stop_server >/dev/null
}

lan_host() {
  if [ -n "${SAMOSA_LAN_HOST:-}" ]; then
    case "$SAMOSA_LAN_HOST" in *[!A-Za-z0-9._:-]*) return 1 ;; esac
    printf '%s\n' "$SAMOSA_LAN_HOST"
    return 0
  fi
  if [ "$(uname -s)" = Darwin ]; then
    interface=$(/sbin/route -n get default 2>/dev/null |
      awk '$1 == "interface:" { print $2; exit }')
    if [ -n "$interface" ]; then
      address=$(/usr/sbin/ipconfig getifaddr "$interface" 2>/dev/null || true)
      if [ -n "$address" ]; then printf '%s\n' "$address"; return 0; fi
    fi
    for interface in en0 en1; do
      address=$(/usr/sbin/ipconfig getifaddr "$interface" 2>/dev/null || true)
      if [ -n "$address" ]; then printf '%s\n' "$address"; return 0; fi
    done
  elif command -v hostname >/dev/null 2>&1; then
    address=$(hostname -I 2>/dev/null |
      awk '{ for (i=1; i<=NF; i++) if ($i ~ /^[0-9]+\./ && $i !~ /^127\./) { print $i; exit } }')
    if [ -n "$address" ]; then printf '%s\n' "$address"; return 0; fi
  fi
  if command -v ifconfig >/dev/null 2>&1; then
    address=$(ifconfig 2>/dev/null |
      awk '$1 == "inet" && $2 !~ /^127\./ && $2 !~ /^169\.254\./ { print $2; exit }')
    if [ -n "$address" ]; then printf '%s\n' "$address"; return 0; fi
  fi
  if [ "$(uname -s)" = Darwin ] && command -v scutil >/dev/null 2>&1; then
    name=$(scutil --get LocalHostName 2>/dev/null || true)
    if [ -n "$name" ]; then printf '%s.local\n' "$name"; return 0; fi
  fi
  return 1
}

lan_url() {
  host=$(lan_host) || return 1
  printf 'http://%s:%s/\n' "$host" "$PORT"
}

print_server_location() {
  if [ "$LAN_MODE" != 1 ]; then
    echo "Samosa server running independently at http://127.0.0.1:$PORT"
    return 0
  fi
  echo "Samosa LAN access is on."
  echo "This Mac:     http://127.0.0.1:$PORT"
  shared_url=$(lan_url || true)
  if [ -n "$shared_url" ]; then
    echo "Other devices: $shared_url"
  else
    echo "Other devices: open this Mac's local-network IP on port $PORT"
  fi
  echo "Password:      $LAN_PASSWORD"
  echo "Stop sharing with: samosa serve --stop"
}

port_owner_pid() {
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -tiTCP:"${1:-$PORT}" -sTCP:LISTEN 2>/dev/null | head -1
  else
    :
  fi
}

process_command() {
  pid=$1
  ps -p "$pid" -o command= 2>/dev/null || true
}

is_samosa_server_pid() {
  pid=$1
  command=$(process_command "$pid")
  case "$command" in
    *samosa-gateway*|*qwen36b*" --serve "*|*qwen36b*" --serve") return 0 ;;
    *) return 1 ;;
  esac
}

is_samosa_backend_pid() {
  pid=$1
  command=$(process_command "$pid")
  llama_server="${SAMOSA_BONSAI_SERVER:-$HOME_DIR/backends/prism-llama.cpp/build/bin/llama-server}"
  maple_engine="${SAMOSA_MAPLE_ENGINE:-$HOME_DIR/current/bin/samosa-maple}"
  case "$command" in
    "$ENGINE"|"$ENGINE"*|"$llama_server"|"$llama_server"*|"$maple_engine"|"$maple_engine"*|\
    "$HOME_DIR"/bin/qwen36b*|"$HOME_DIR"/current/bin/qwen36b*|"$HOME_DIR"/releases/*/bin/qwen36b*|\
    "$HOME_DIR"/backends/*/llama-server*|"$HOME_DIR"/current/bin/samosa-maple*|\
    "$HOME_DIR"/releases/*/bin/samosa-maple*|*qwen36b*" --serve "*|*qwen36b*" --serve") return 0 ;;
    *) return 1 ;;
  esac
}

cleanup_stale_backend() {
  pid=""
  if [ -s "$BACKEND_PID_FILE" ]; then
    candidate=$(tr -d '[:space:]' <"$BACKEND_PID_FILE")
    case "$candidate" in ''|*[!0-9]*) : ;; *) pid=$candidate ;; esac
  fi
  if [ -z "$pid" ]; then
    pid=$(port_owner_pid "$BACKEND_PORT")
  fi
  if [ -z "$pid" ]; then
    rm -f "$BACKEND_PID_FILE"
    return 0
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$BACKEND_PID_FILE"
    return 0
  fi
  if ! is_samosa_backend_pid "$pid"; then
    command=$(process_command "$pid")
    fail "private model port $BACKEND_PORT is occupied by process $pid: $command"
  fi
  say "recovering stale local model process $pid"
  kill -TERM "$pid" 2>/dev/null || true
  i=0
  while [ -n "$(port_owner_pid "$BACKEND_PORT")" ] && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
  done
  owner=$(port_owner_pid "$BACKEND_PORT")
  if [ "$owner" = "$pid" ]; then
    kill -KILL "$pid" 2>/dev/null || true
    i=0
    while [ -n "$(port_owner_pid "$BACKEND_PORT")" ] && [ "$i" -lt 20 ]; do
      sleep 0.1
      i=$((i + 1))
    done
  fi
  rm -f "$BACKEND_PID_FILE"
  owner=$(port_owner_pid "$BACKEND_PORT")
  [ -z "$owner" ] || fail "private model port $BACKEND_PORT is still occupied by process $owner"
}

require_port_free_or_samosa_running() {
  if server_running; then
    say "server already running at http://127.0.0.1:$PORT"
    return 0
  fi
  pid=$(port_owner_pid)
  if [ -n "$pid" ]; then
    command=$(process_command "$pid")
    if is_samosa_server_pid "$pid"; then
      fail "Samosa process $pid is already listening on port $PORT but is not healthy. Run: samosa serve --stop"
    fi
    fail "port $PORT is already in use by process $pid: $command"
  fi
  return 1
}

serve_foreground() {
  restart_for_bind_change
  if require_port_free_or_samosa_running; then
    return 0
  fi
  cleanup_stale_backend
  [ -x "$GATEWAY" ] || fail "the browser control plane (samosa-gateway) is missing - reinstall Samosa"
  mkdir -p "$HOME_DIR/chats"
  SAMOSA_PORT="$PORT" SAMOSA_BIND="$BIND_ADDRESS" SAMOSA_LAN="$LAN_MODE" \
    SAMOSA_LAN_PASSWORD="$LAN_PASSWORD" \
    SAMOSA_QWEN_ENGINE="$ENGINE" SAMOSA_QWEN_MODEL="$MODEL" \
    SAMOSA_TOKENIZER="$TOKENIZER" SAMOSA_APP_HTML="$APP_HTML" \
    SAMOSA_APP_LOGO="$APP_LOGO" SAMOSA_CONTEXT_TOKENS="$CONTEXT_TOKENS" \
    SAMOSA_VOICE_TRACE_AUTO="$VOICE_TRACE_AUTO" \
    SAMOSA_APP_VERSION="$SAMOSA_VERSION" \
    SAMOSA_CHUTNI_SERVICE="$RELEASE_DIR/bin/chutni-mcp" \
    SAMOSA_MODELS_CATALOG="$MODELS_CATALOG" \
    exec "$GATEWAY"
}

launchd_available() {
  [ "${SAMOSA_DISABLE_LAUNCHD:-0}" != 1 ] &&
    [ "$(uname -s)" = "Darwin" ] && command -v "$LAUNCHCTL" >/dev/null 2>&1
}

xml_escape() {
  printf '%s' "$1" |
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' \
        -e 's/"/\&quot;/g' -e "s/'/\&apos;/g"
}

write_launchd_plist() {
  mkdir -p "$RUN_DIR"
  x_label=$(xml_escape "$LAUNCH_LABEL")
  x_gateway=$(xml_escape "$GATEWAY")
  x_home=$(xml_escape "$HOME_DIR")
  x_port=$(xml_escape "$PORT")
  x_bind=$(xml_escape "$BIND_ADDRESS")
  x_lan=$(xml_escape "$LAN_MODE")
  x_lan_password=$(xml_escape "$LAN_PASSWORD")
  x_engine=$(xml_escape "$ENGINE")
  x_model=$(xml_escape "$MODEL")
  x_tokenizer=$(xml_escape "$TOKENIZER")
  x_html=$(xml_escape "$APP_HTML")
  x_logo=$(xml_escape "$APP_LOGO")
  x_context=$(xml_escape "$CONTEXT_TOKENS")
  x_voice_trace_auto=$(xml_escape "$VOICE_TRACE_AUTO")
  x_version=$(xml_escape "$SAMOSA_VERSION")
  x_chutni=$(xml_escape "$RELEASE_DIR/bin/chutni-mcp")
  x_models_catalog=$(xml_escape "$MODELS_CATALOG")
  x_log=$(xml_escape "$SERVER_LOG")
  cat >"$LAUNCHD_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$x_label</string>
  <key>ProgramArguments</key>
  <array><string>$x_gateway</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SAMOSA_HOME</key><string>$x_home</string>
    <key>SAMOSA_PORT</key><string>$x_port</string>
    <key>SAMOSA_BIND</key><string>$x_bind</string>
    <key>SAMOSA_LAN</key><string>$x_lan</string>
    <key>SAMOSA_LAN_PASSWORD</key><string>$x_lan_password</string>
    <key>SAMOSA_QWEN_ENGINE</key><string>$x_engine</string>
    <key>SAMOSA_QWEN_MODEL</key><string>$x_model</string>
    <key>SAMOSA_TOKENIZER</key><string>$x_tokenizer</string>
    <key>SAMOSA_APP_HTML</key><string>$x_html</string>
    <key>SAMOSA_APP_LOGO</key><string>$x_logo</string>
    <key>SAMOSA_CONTEXT_TOKENS</key><string>$x_context</string>
    <key>SAMOSA_VOICE_TRACE_AUTO</key><string>$x_voice_trace_auto</string>
    <key>SAMOSA_APP_VERSION</key><string>$x_version</string>
    <key>SAMOSA_CHUTNI_SERVICE</key><string>$x_chutni</string>
    <key>SAMOSA_MODELS_CATALOG</key><string>$x_models_catalog</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$x_log</string>
  <key>StandardErrorPath</key><string>$x_log</string>
</dict>
</plist>
EOF
  chmod 600 "$LAUNCHD_PLIST"
}

start_server_launchd() {
  write_launchd_plist
  "$LAUNCHCTL" bootout "$LAUNCH_DOMAIN/$LAUNCH_LABEL" >/dev/null 2>&1 || true
  # launchd can acknowledge bootout before the old job has fully left its
  # domain. An immediate bootstrap then fails once even though the plist is
  # valid. Retry that bounded teardown race instead of reporting a false app
  # startup failure to the user.
  i=0
  while [ "$i" -lt 20 ]; do
    "$LAUNCHCTL" bootstrap "$LAUNCH_DOMAIN" "$LAUNCHD_PLIST" >/dev/null 2>&1 && return 0
    sleep 0.1
    i=$((i + 1))
  done
  echo "Samosa could not register its macOS background service after retrying; see $SERVER_LOG" >&2
  return 1
}

start_server_detached() {
  if command -v setsid >/dev/null 2>&1; then
    nohup setsid env SAMOSA_HOME="$HOME_DIR" SAMOSA_PORT="$PORT" \
      SAMOSA_BIND="$BIND_ADDRESS" \
      SAMOSA_LAN="$LAN_MODE" SAMOSA_LAN_PASSWORD="$LAN_PASSWORD" \
      SAMOSA_QWEN_ENGINE="$ENGINE" SAMOSA_QWEN_MODEL="$MODEL" \
      SAMOSA_TOKENIZER="$TOKENIZER" SAMOSA_APP_HTML="$APP_HTML" \
      SAMOSA_APP_LOGO="$APP_LOGO" SAMOSA_CONTEXT_TOKENS="$CONTEXT_TOKENS" \
      SAMOSA_VOICE_TRACE_AUTO="$VOICE_TRACE_AUTO" \
      SAMOSA_APP_VERSION="$SAMOSA_VERSION" SAMOSA_APP_LIFECYCLE="$APP_LIFECYCLE" \
      SAMOSA_CHUTNI_SERVICE="$RELEASE_DIR/bin/chutni-mcp" \
      SAMOSA_MODELS_CATALOG="$MODELS_CATALOG" \
      "$GATEWAY" >"$SERVER_LOG" 2>&1 </dev/null &
  else
    nohup env SAMOSA_HOME="$HOME_DIR" SAMOSA_PORT="$PORT" \
      SAMOSA_BIND="$BIND_ADDRESS" \
      SAMOSA_LAN="$LAN_MODE" SAMOSA_LAN_PASSWORD="$LAN_PASSWORD" \
      SAMOSA_QWEN_ENGINE="$ENGINE" SAMOSA_QWEN_MODEL="$MODEL" \
      SAMOSA_TOKENIZER="$TOKENIZER" SAMOSA_APP_HTML="$APP_HTML" \
      SAMOSA_APP_LOGO="$APP_LOGO" SAMOSA_CONTEXT_TOKENS="$CONTEXT_TOKENS" \
      SAMOSA_VOICE_TRACE_AUTO="$VOICE_TRACE_AUTO" \
      SAMOSA_APP_VERSION="$SAMOSA_VERSION" SAMOSA_APP_LIFECYCLE="$APP_LIFECYCLE" \
      SAMOSA_CHUTNI_SERVICE="$RELEASE_DIR/bin/chutni-mcp" \
      SAMOSA_MODELS_CATALOG="$MODELS_CATALOG" \
      "$GATEWAY" >"$SERVER_LOG" 2>&1 </dev/null &
  fi
  pid=$!
  printf '%s\n' "$pid" >"$PID_FILE"
}

start_server() {
  # App-owned servers must not be placed under launchd's KeepAlive policy:
  # closing the browser needs to be able to terminate the whole Samosa tree,
  # and killing its gateway must not cause launchd to respawn it. Use the full
  # authenticated stop path before changing ownership. Merely booting launchd
  # out closes the listener before the old gateway PID is reaped; the stale-PID
  # check below can then race that exiting process and reject `samosa app`.
  if [ "$APP_LIFECYCLE" = 1 ] && launchd_available; then
    stop_server >/dev/null
  fi
  restart_for_bind_change
  server_running && return 0
  pid=$(port_owner_pid)
  if [ -n "$pid" ]; then
    command=$(process_command "$pid")
    if is_samosa_server_pid "$pid"; then
      echo "Samosa server process $pid exists but is not healthy; run: samosa serve --stop" >&2
    else
      echo "port $PORT is already in use by process $pid: $command" >&2
    fi
    return 1
  fi
  [ -x "$GATEWAY" ] || fail "the browser control plane (samosa-gateway) is missing - reinstall Samosa"
  mkdir -p "$HOME_DIR/chats"
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null; then
    echo "Samosa server process exists but is not healthy; see $SERVER_LOG" >&2
    return 1
  fi
  cleanup_stale_backend
  if [ "$APP_LIFECYCLE" = 1 ]; then
    start_server_detached
  elif launchd_available; then
    start_server_launchd || return 1
    pid=
  else
    start_server_detached
  fi
  i=0
  while [ "$i" -lt 240 ]; do
    if server_running; then
      owner=$(port_owner_pid)
      [ -z "$owner" ] || printf '%s\n' "$owner" >"$PID_FILE"
      return 0
    fi
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      echo "Samosa server failed to start; see $SERVER_LOG" >&2
      rm -f "$PID_FILE"
      return 1
    fi
    sleep 0.5
    i=$((i + 1))
  done
  echo "Samosa server did not become ready within 120 seconds; see $SERVER_LOG" >&2
  return 1
}

stop_server() {
  if server_running && [ -s "$UI_TOKEN_FILE" ]; then
    ui_token=$(tr -d '\r\n' <"$UI_TOKEN_FILE")
    if [ -n "$ui_token" ]; then
      "$CURL" -fsS --max-time 5 -X POST -H "X-Samosa-Token: $ui_token" \
        "http://127.0.0.1:$PORT/v1/shutdown" >/dev/null || true
    fi
  fi
  # Boot out only after giving the gateway an authenticated graceful-stop
  # request. Doing this first hid the shutdown cause as a generic SIGTERM.
  if launchd_available; then
    "$LAUNCHCTL" bootout "$LAUNCH_DOMAIN/$LAUNCH_LABEL" >/dev/null 2>&1 || true
  fi
  if server_running; then
    i=0
    while server_running && [ "$i" -lt 50 ]; do
      sleep 0.1
      i=$((i + 1))
    done
  fi
  if [ -f "$PID_FILE" ]; then
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    i=0
    while [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && [ "$i" -lt 50 ]; do
      sleep 0.1
      i=$((i + 1))
    done
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  fi
  pid=$(port_owner_pid)
  if [ -n "$pid" ] && is_samosa_server_pid "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 50 ]; do
      sleep 0.1
      i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  cleanup_stale_backend
  echo "Samosa server stopped."
}

doctor() {
  ok=1
  echo "version:   $SAMOSA_VERSION"
  [ "$RELEASE_DIR" = "$HOME_DIR" ] || echo "release:   $(basename "$RELEASE_DIR")"
  [ -x "$ENGINE" ] && echo "engine:    ok ($ENGINE)" || { echo "engine:    MISSING - re-run the installer"; ok=0; }
  if [ -x "$HOME_DIR/backends/prism-llama.cpp/build/bin/llama-server" ] &&
     [ -f "$HOME_DIR/models/bonsai-27b-1bit/Bonsai-27B-Q1_0.gguf" ]; then
    echo "bonsai:    ok (27B 1-bit)"
  else
    echo "bonsai:    not installed (optional)"
  fi
  # A model-free runtime is a normal, supported state (docs/TASKS_UI_CHUTNI.md
  # T1.0) -- no Qwen weights yet is not an installation failure, so it does
  # not clear `ok`. Format/tokenizer checks only apply once weights exist;
  # otherwise there is nothing yet to be broken.
  if [ -f "$MODEL/experts.bin" ]; then
    echo "model:     ok ($(du -sh "$MODEL" 2>/dev/null | awk '{print $1}'))"
    if [ -f "$MODEL/manifest.json" ]; then
      if grep -q 'groupwise-q4-gate-up-row-q8-down-v1' "$MODEL/manifest.json"; then
        echo "format:    mixed group-q4 gate/up + row-q8 down (experimental)"
      elif grep -q 'groupwise-symmetric-q4-v1' "$MODEL/manifest.json"; then
        group=$(sed -n 's/.*"group_size"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$MODEL/manifest.json" | head -1)
        echo "format:    groupwise q4 (group ${group:-unknown})"
      else
        echo "format:    LEGACY whole-row q4 - upgrade required"
      fi
    else
      echo "format:    UNKNOWN (manifest missing)"
      ok=0
    fi
    [ -f "$TOKENIZER" ] && echo "tokenizer: ok" || { echo "tokenizer: MISSING"; ok=0; }
  else
    echo "model:     none installed yet - open the app or run 'samosa pull' to install one"
  fi
  if [ -d "$HOME_DIR/releases" ]; then
    releases=$(find "$HOME_DIR/releases" -mindepth 1 -maxdepth 1 -type d ! -name '.*.partial' 2>/dev/null | wc -l | tr -d ' ')
    [ "$releases" -le 1 ] || echo "rollback:  $((releases - 1)) previous verified release(s) retained"
  fi
  [ ! -d "$HOME_DIR/model" ] || [ "$RELEASE_DIR" = "$HOME_DIR" ] ||
    echo "legacy:    ~/.samosa/model retained from the pre-versioned installer"
  [ -f "$SESSION" ] && echo "session:   $(du -h "$SESSION" | awk '{print $1}') (samosa --continue works)" || echo "session:   none yet"
  IN_CONTAINER=0
  if [ -f /.dockerenv ] || grep -q 'docker\|containerd' /proc/self/cgroup 2>/dev/null; then
    IN_CONTAINER=1
  fi
  
  if [ "$IN_CONTAINER" = 1 ]; then
    echo "env:       container"
    if [ -f /sys/fs/cgroup/memory.max ]; then
      max_bytes=$(cat /sys/fs/cgroup/memory.max)
      if [ "$max_bytes" = "max" ]; then
        echo "ram:       unlimited (cgroup)"
      else
        RAM_GB=$((max_bytes / 1073741824))
        echo "ram:       $RAM_GB GB (cgroup)"
        if [ "$RAM_GB" -lt 6 ]; then
          echo "WARNING:   cgroup limit is less than 6 GB. Raise Docker Desktop VM RAM."
        fi
      fi
    else
      echo "ram:       unknown (cgroup)"
    fi
    
    # Check mount type to warn about virtiofs/9p slow mounts
    mount_device=$(df -P "$MODEL" 2>/dev/null | awk 'NR==2 {print $1}')
    mount_type=$(awk -v m="$MODEL" '$2==m {print $3}' /proc/mounts 2>/dev/null)
    if [ -z "$mount_type" ]; then
      mount_type=$(awk -v m="$(df -P "$MODEL" 2>/dev/null | awk 'NR==2 {print $6}')" '$2==m {print $3}' /proc/mounts 2>/dev/null)
    fi
    if [ "$mount_type" = "virtiofs" ] || [ "$mount_type" = "9p" ] || [ "$mount_type" = "fakeowner" ] || [ "$mount_type" = "osxfs" ] || [ "$mount_type" = "grpcfuse" ] || echo "$mount_device" | grep -q -E 'virtiofs|9p|host|grpcfuse'; then
      echo "WARNING:   model is mounted via ${mount_type:-9p/virtiofs} ($mount_device). This causes a 10x slowdown. Use a named Docker volume instead."
    fi
  else
    if [ "$(uname -s)" = "Darwin" ]; then
      RAM_GB=$(( $(sysctl -n hw.memsize) / 1073741824 ))
    else
      RAM_KB=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
      RAM_GB=$(( RAM_KB / 1048576 ))
    fi
    echo "ram:       $RAM_GB GB"
  fi
  [ "$ok" = 1 ] && echo "all good." || exit 1
}

if [ "${1:-}" = "pull" ]; then
  shift
  [ "$#" = 0 ] || usage
  pull_model
  exit 0
fi

if [ "${1:-}" = "serve" ]; then
  shift
  if [ "${1:-}" = "--stop" ]; then
    [ "$#" = 1 ] || usage
    stop_server
    exit 0
  fi
  FOREGROUND=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --foreground) FOREGROUND=1 ;;
      --lan) BIND_ADDRESS=0.0.0.0; LAN_MODE=1 ;;
      --context-tokens)
        shift
        [ "$#" -gt 0 ] && context_tokens_value "$1" ||
          fail "--context-tokens requires auto or a positive integer"
        CONTEXT_TOKENS=$1
        ;;
      *) usage ;;
    esac
    shift
  done
  if [ "$FOREGROUND" = 1 ]; then
    serve_foreground
  else
    start_server
    print_server_location
  fi
  exit 0
fi

if [ "${1:-}" = "app" ]; then
  shift
  # A normal app launch uses the same persistent supervisor as `serve`, so
  # the local UI cannot disappear when a terminal or automation host reaps
  # detached children after this short-lived launcher returns. Browser-owned
  # shutdown remains available for lifecycle-specific integration tests and
  # compatibility via an explicit environment override.
  APP_LIFECYCLE="${SAMOSA_APP_LIFECYCLE:-0}"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --lan) BIND_ADDRESS=0.0.0.0; LAN_MODE=1 ;;
      --context-tokens)
        shift
        [ "$#" -gt 0 ] && context_tokens_value "$1" ||
          fail "--context-tokens requires auto or a positive integer"
        CONTEXT_TOKENS=$1
        ;;
      *) usage ;;
    esac
    shift
  done
  start_server
  url="http://127.0.0.1:$PORT"
  if [ "$LAN_MODE" != 1 ]; then echo "$url"; else print_server_location; fi
  "$OPEN" "$url"
  exit 0
fi

if [ "${1:-}" = "jobs" ]; then
  shift
  [ "$#" = 0 ] || fail "Jobs arguments are no longer accepted; run Jobs from the local app."
  start_server
  echo "Jobs is available at http://127.0.0.1:$PORT"
  exit 0
fi

if [ "${1:-}" = "version" ]; then
  shift
  [ "$#" = 0 ] || usage
  print_version
  exit 0
fi

while [ $# -gt 0 ]; do
  case "$1" in
    --continue) [ -f "$SESSION" ] && RESUME=1 || echo "(no previous conversation - starting fresh)" ;;
    --think)    PROFILE="think" ;;
    --think-code) PROFILE="think-code" ;;
    --fast)
      SAMOSA_FAST=1
      export SAMOSA_FAST
      ;;
    --seed)
      shift
      [ $# -gt 0 ] && positive_integer "$1" || { echo "--seed requires a positive integer" >&2; exit 1; }
      SEED="$1"
      ;;
    --max-tokens)
      shift
      [ $# -gt 0 ] && positive_integer "$1" || { echo "--max-tokens requires a positive integer" >&2; exit 1; }
      TOKENS="$1"
      ;;
    --context-tokens)
      shift
      [ $# -gt 0 ] && context_tokens_value "$1" || { echo "--context-tokens requires auto or a positive integer" >&2; exit 1; }
      CONTEXT_TOKENS="$1"
      ;;
    --thinking-budget)
      shift
      [ $# -gt 0 ] && positive_integer "$1" || { echo "--thinking-budget requires a positive integer" >&2; exit 1; }
      THINKING_BUDGET="$1"
      ;;
    doctor)     doctor; exit 0 ;;
    -v|--version) print_version; exit 0 ;;
    -h|--help)  usage ;;
    --*)        echo "unknown flag: $1 (try: samosa --help)"; exit 1 ;;
    *)          break ;;
  esac
  shift
done

[ $# -gt 0 ] || usage
PROMPT="$*"

[ -n "$TOKENS" ] || TOKENS=8192
case "$PROFILE" in
  direct)     THINKING_BUDGET="" ;;
  think)      [ -n "$THINKING_BUDGET" ] || THINKING_BUDGET=1024 ;;
  think-code) [ -n "$THINKING_BUDGET" ] || THINKING_BUDGET=2048 ;;
esac

if [ -n "$RESUME" ]; then
  set -- --resume-session "$SESSION" --chat "$PROMPT"
else
  set -- --chat "$PROMPT"
fi

case "$PROFILE" in
  direct)     set -- "$@" --no-thinking ;;
  think)      : ;;
  think-code) set -- "$@" --thinking-code ;;
esac

set -- "$@" --stream --tokens "$TOKENS" --tokenizer "$TOKENIZER" \
  --save-session "$SESSION"
[ "$CONTEXT_TOKENS" = "auto" ] || set -- "$@" --context-tokens "$CONTEXT_TOKENS"
[ -z "$SEED" ] || set -- "$@" --seed "$SEED"
[ -z "$THINKING_BUDGET" ] || set -- "$@" --thinking-budget "$THINKING_BUDGET"

SNAP="$MODEL" exec "$ENGINE" "$@" 2>/dev/null
